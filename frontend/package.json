{
  "name": "credit-cabinet-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../docs/api/openapi.yaml -o src/api-types.ts",
    "test:e2e": "playwright test",
    "media": "playwright test -c media/playwright.media.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "antd": "^5.27.0",
    "@ant-design/icons": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.10.0",
    "@playwright/test": "^1.56.0"
  }
}
