<mxfile host="app.diagrams.net"><diagram name="C4 L1 · Контекст" id="0"><mxGraphModel dx="1557" dy="995" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p_cl" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Клиент-предприниматель&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Директор или бухгалтер ИП и ООО. Подбирает кредит, подаёт заявку, принимает оффер&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];"><mxGeometry x="15" y="90" width="310" height="270" as="geometry"/></mxCell><mxCell id="p_uw" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Андеррайтер банка&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Разбирает пограничные заявки, принимает ручное решение&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];"><mxGeometry x="15" y="560" width="310" height="270" as="geometry"/></mxCell><mxCell id="sys" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Умный кредитный кабинет&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Онлайн-кредитование МСБ: заявка, проверки, скоринг, решение, оффер&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];"><mxGeometry x="640" y="420" width="360" height="180" as="geometry"/></mxCell><mxCell id="egr" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;ЕГРЮЛ&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Регистрационные данные компании (мок)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];"><mxGeometry x="1300" y="40" width="330" height="170" as="geometry"/></mxCell><mxCell id="fns" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;ФНС&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Налоговая отчётность и задолженность (мок)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];"><mxGeometry x="1300" y="290" width="330" height="170" as="geometry"/></mxCell><mxCell id="bki" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;БКИ&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software Sys