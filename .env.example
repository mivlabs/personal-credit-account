# Скопируйте в .env, чтобы переопределить значения. Без .env docker compose работает на значениях по умолчанию.
# Секреты здесь только демонстрационные: в любом реальном окружении их надо сменить.

# --- PostgreSQL ---
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit
# Порт БД на хосте (только 127.0.0.1) — для отладки и локальных тестов; 55432, чтобы не конфликтовать с локальным Postgres
DB_HOST_PORT=55432

# --- API ядра ---
API_PORT=8000
# Секрет подписи JWT (HS256), не короче 32 символов. Пусто (по умолчанию): при первом старте создаётся
# случайный секрет и сохраняется в файл на volume jwtdata. Демо-значение и короткие секреты игнорируются.
JWT_SECRET=
# Демо-режим: ответ offer/accept содержит подсказку с кодом подписи (true/false)
DEMO_MODE=true
# Срок жизни токена, минуты
JWT_TTL_MINUTES=480
# Разрешённые origin фронта через запятую (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Демо-код подписания договора (симуляция, никаких реальных SMS)
DEMO_SIGN_CODE=123456
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Общий бюджет времени на опрос ЕГРЮЛ/ФНС/БКИ с ретраями, секунды
EXTERNAL_CHECKS_BUDGET_SECONDS=3
# Оставлено для совместимости; синхронный конвейер не делает искусственных пауз
PIPELINE_STEP_DELAY_SECONDS=0

# Ключевая ставка ЦБ (policy.yaml: 14.0 на 2026-09-11, решение Совета директоров Банка России).
# Перед проверкой сверьте значение с cbr.ru; пусто = значение из policy.yaml
KEY_RATE_PCT=
KEY_RATE_DATE=
# Срок действия оффера и срок ответа на запрос данных, дни
OFFER_TTL_DAYS=30
INFO_REQUEST_TTL_DAYS=14
# Дата расчёта возраста компании (YYYY-MM-DD); пусто = сегодня по Europe/Moscow
AS_OF_DATE=

# --- Моки внешних сервисов (WireMock: ЕГРЮЛ, ФНС, БКИ) ---
MOCKS_PORT=8081

# --- Веб-интерфейс (Nginx) ---
WEB_PORT=3000
