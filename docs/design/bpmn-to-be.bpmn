ринг"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="T5" name="Применить кредитную политику"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="G2" name="Результат политики"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T7" name="Сформировать отказ с причиной"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="ER" name="Отказ отправлен"><bpmn:incoming>F13</bpmn:incoming><bpmn:messageEventDefinition id="MED_ER"/></bpmn:endEvent><bpmn:serviceTask id="T6" name="Сформировать оффер или контроффер"><bpmn:incoming>F10</bpmn:incoming><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T8" name="Рассмотреть заявку вручную"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G4" name="Решение андеррайтера"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="ER2" name="Отказ отправлен"><bpmn:incoming>F16</bpmn:incoming><bpmn:messageEventDefinition id="MED_ER2"/></bpmn:endEvent><bpmn:sendTask id="T9" name="Отправить оффер клиенту"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:sendTask><bpmn:intermediateCatchEvent id="E2" name="Ответ клиента получен"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:messageEventDefinition id="MED_E2"/></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="G3" name="Оффер принят?"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>